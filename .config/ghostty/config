theme = Terminal.app iTerm

font-size = 18
font-family = SF Mono
font-style = SemiBold
font-style-bold = Heavy
font-style-italic = SemiBold Italic
font-style-bold-italic = Heavy Italic

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

window-step-resize = true
window-width = 110
window-height = 30
window-padding-x = 10
window-padding-y = 2

bold-is-bright = true

macos-option-as-alt = left
macos-titlebar-style = tabs

macos-icon = glass

term = xterm-256color

keybind = cmd+.=esc:.
