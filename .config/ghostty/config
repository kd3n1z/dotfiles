theme = Terminal.app iTerm

font-size = 16
font-family = SF Mono
font-style = Bold
font-style-bold = Heavy
font-style-italic = Bold Italic
font-style-bold-italic = Heavy Italic

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

window-step-resize = true
window-width = 100
window-height = 25
window-padding-x = 10
window-padding-y = 5

bold-is-bright = true

macos-option-as-alt = left
macos-titlebar-style = tabs

macos-icon = glass

term = xterm-256color

keybind = cmd+.=esc:.
